# Copy to .env for local work. Never commit real values.

# "dev" lets you pick a seeded Member locally, with no Microsoft sign-in. Refused in production.
# "entra" uses Microsoft sign-in.
AUTH_MODE=dev
SESSION_SECRET=replace-with-at-least-32-random-characters

# "memory" uses illustrative seed data in memory. "lists" uses Microsoft Lists via Graph.
STORE=memory

# Microsoft Entra (single tenant, ADR 0001 and 0003)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
APP_BASE_URL=http://localhost:3000
# App identity for SharePoint (Sites.Selected), certificate auth
ENTRA_CERT_THUMBPRINT_SHA256=
ENTRA_CERT_PRIVATE_KEY_PATH=
# Delegated sign-in secret (sign-in only, User.Read)
ENTRA_CLIENT_SECRET=

# SharePoint site that holds the board
SHAREPOINT_SITE_ID=

# Capture (spec P0.10). Off until spec question Q1 is answered.
CAPTURE_ENABLED=false
ANTHROPIC_API_KEY=

# Claude access (spec P1.1). Off until spec question Q1 is answered. See docs/setup.md, section 7.
# Locally (AUTH_MODE=dev) Claude Code can connect with the header "Authorization: Bearer dev:<member id>".
CLAUDE_ACCESS_ENABLED=false
