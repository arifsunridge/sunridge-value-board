# Copy to .env for local work. Never commit real values.

# "dev" lets you choose a seeded Person locally (a Member, or an invented HBF Manager). Refused in production.
# "portal" signs people in through the HBF Portal (Cloudflare Access + the portal's access check, ADR 0006).
AUTH_MODE=dev
SESSION_SECRET=replace-with-at-least-32-random-characters

# "memory" uses illustrative seed data in memory. "mysql" uses the board's own database on the Render MySQL.
STORE=memory
APP_BASE_URL=http://localhost:3000

# HBF Portal sign-in (AUTH_MODE=portal)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
PORTAL_INTERNAL_URL=
PORTAL_SERVICE_TOKEN=
PORTAL_APP_SLUG=value-board
PORTAL_URL=https://hbf.sunridge.app
# The Company whose Managers sign in through this portal (its id on the board).
PORTAL_COMPANY_ID=hbf

# MySQL (STORE=mysql). Never the live HBF database: hbroch.com hosts are refused.
DB_HOST=
DB_PORT=3306
DB_USER=value_board
DB_PASSWORD=
DB_NAME=value_board
DB_SSL=false

# Capture (spec P0.10). Off until spec question Q1 is answered.
CAPTURE_ENABLED=false
ANTHROPIC_API_KEY=

# Claude access (spec P1.1, ADR 0004). Off until /mcp is exempted from Cloudflare Access and Q1 is answered.
# Locally (AUTH_MODE=dev) Claude Code can connect with the header "Authorization: Bearer dev:<person id>".
CLAUDE_ACCESS_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
